{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idengar",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "account_id": "8d6b380bb3adbf6aa2e9042fddda0463",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "PERMOHONAN", "id": "cd4afc1710f5483db3e51d9951980a2d" }
  ],
  "observability": { "enabled": true }
}
