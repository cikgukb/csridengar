{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idengar",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "account_id": "9958b8f629284b0129b7194e7e454527",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "PERMOHONAN", "id": "33cb8a3881fb4bce9b5b127e5270d368" }
  ],
  "observability": { "enabled": true }
}
